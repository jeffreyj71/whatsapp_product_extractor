# Server port (default: 3001)
PORT=3001

# WhatsApp session storage path
SESSION_DATA_PATH=.wwebjs_auth

# Where to save Excel output files
OUTPUT_PATH=output

# Log level: error | warn | info | debug
LOG_LEVEL=info

# NLP product score threshold 0-100 (default: 30)
NLP_THRESHOLD=30

# Buffer window in seconds before flushing grouped messages (default: 60)
BUFFER_WINDOW_SECONDS=60
