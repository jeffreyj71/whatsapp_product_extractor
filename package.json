    "form-data": "^4.0.6",
    "ics": "^3.12.0",
    "puppeteer": "^22.15.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.3",
    "tesseract.js": "^7.0.0",
    "whatsapp-web.js": "^1.34.7",
    "winston": "^3.13.1",
    "ws": "^8.18.0"
